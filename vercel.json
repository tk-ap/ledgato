{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd web && npm install",
  "buildCommand": "cd web && npm run test && npm run build",
  "outputDirectory": "web/dist",
  "redirects": [
    {
      "source": "/signup",
      "destination": "/login",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/app",
      "destination": "/api/app-gate?next=/app"
    },
    {
      "source": "/app/:path*",
      "destination": "/api/app-gate?next=/app/:path*"
    },
    {
      "source": "/agent-controls/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/how-it-works/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    }
  ]
}
